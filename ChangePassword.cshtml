@model MiniSmartstoreMvc.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="container smart-account-page">
    <div class="smart-account-layout">
        <partial name="_CustomerSidebar" />

        <main class="smart-account-content">
            <h1 class="smart-account-main-title">Đổi mật khẩu</h1>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            <form asp-controller="Customer"
                  asp-action="ChangePassword"
                  method="post"
                  class="smart-change-password-form">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="smart-password-form-row">
                    <label asp-for="OldPassword">Mật khẩu cũ *</label>

                    <div class="smart-password-field">
                        <input asp-for="OldPassword"
                               class="form-control"
                               placeholder="Nhập mật khẩu cũ" />

                        <span asp-validation-for="OldPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="smart-password-form-row">
                    <label asp-for="NewPassword">Mật khẩu mới *</label>

                    <div class="smart-password-field">
                        <input asp-for="NewPassword"
                               class="form-control"
                               placeholder="Nhập mật khẩu mới" />

                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="smart-password-form-row">
                    <label asp-for="ConfirmPassword">Xác nhận mật khẩu *</label>

                    <div class="smart-password-field">
                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               placeholder="Nhập lại mật khẩu mới" />

                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="smart-password-form-row">
                    <label></label>

                    <div>
                        <p class="smart-password-note">
                            * Các trường có dấu sao là bắt buộc.
                        </p>

                        <button type="submit" class="smart-password-save-btn">
                            ✓ Đổi mật khẩu
                        </button>
                    </div>
                </div>
            </form>
        </main>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}