@using MiniSmartstoreMvc.Models
@model IEnumerable<MiniSmartstoreMvc.Models.Order>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="admin-page-title">
    <h2>Quản lý đơn hàng</h2>
    <p>Theo dõi, tìm kiếm và cập nhật trạng thái đơn hàng.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="admin-card mb-4">
    <div class="admin-card-body">
        <form asp-area="Admin" asp-controller="Order" asp-action="Index" method="get" class="row g-3">
            <div class="col-md-4">
                <input type="text"
                       name="keyword"
                       value="@ViewBag.Keyword"
                       class="form-control"
                       placeholder="Tìm mã đơn, tên khách, số điện thoại..." />
            </div>

            <div class="col-md-3">
                <select name="orderStatus" class="form-select">
                    <option value="">Tất cả trạng thái đơn</option>

                    @foreach (var status in Enum.GetValues<OrderStatus>())
                    {
                        <option value="@status" selected="@(ViewBag.OrderStatus == status)">
                            @OrderStatusText(status)
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <select name="paymentStatus" class="form-select">
                    <option value="">Tất cả thanh toán</option>

                    @foreach (var status in Enum.GetValues<PaymentStatus>())
                    {
                        <option value="@status" selected="@(ViewBag.PaymentStatus == status)">
                            @PaymentStatusText(status)
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    Lọc
                </button>
            </div>
        </form>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <h5>Danh sách đơn hàng</h5>
    </div>

    <div class="admin-card-body p-0">
        <div class="table-responsive">
            <table class="table admin-table table-bordered">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>SĐT</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái đơn</th>
                        <th>Thanh toán</th>
                        <th>Ngày đặt</th>
                        <th style="width: 120px;">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.OrderCode</strong>
                                </td>

                                <td>@item.CustomerName</td>

                                <td>@item.PhoneNumber</td>

                                <td class="text-danger fw-bold">
                                    @item.TotalAmount.ToString("N0") đ
                                </td>

                                <td>
                                    <span class="badge @OrderStatusBadge(item.OrderStatus)">
                                        @OrderStatusText(item.OrderStatus)
                                    </span>
                                </td>

                                <td>
                                    <span class="badge @PaymentStatusBadge(item.PaymentStatus)">
                                        @PaymentStatusText(item.PaymentStatus)
                                    </span>
                                </td>

                                <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>

                                <td>
                                    <a asp-area="Admin"
                                       asp-controller="Order"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-primary">
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center p-4">
                                Chưa có đơn hàng nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    private string OrderStatusText(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "Chờ xử lý",
            OrderStatus.Processing => "Đang xử lý",
            OrderStatus.Completed => "Hoàn thành",
            OrderStatus.Cancelled => "Đã hủy",
            _ => status.ToString()
        };
    }

    private string PaymentStatusText(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Pending => "Chờ thanh toán",
            PaymentStatus.Paid => "Đã thanh toán",
            PaymentStatus.Failed => "Thất bại",
            PaymentStatus.Cancelled => "Đã hủy",
            _ => status.ToString()
        };
    }

    private string OrderStatusBadge(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "bg-warning text-dark",
            OrderStatus.Processing => "bg-primary",
            OrderStatus.Completed => "bg-success",
            OrderStatus.Cancelled => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private string PaymentStatusBadge(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Pending => "bg-warning text-dark",
            PaymentStatus.Paid => "bg-success",
            PaymentStatus.Failed => "bg-danger",
            PaymentStatus.Cancelled => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}