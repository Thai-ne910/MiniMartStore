@using MiniSmartstoreMvc.Models
@model List<MiniSmartstoreMvc.ViewModels.AdminOrderListItemViewModel>

@{
    Layout = null;
    var total = Model.Sum(x => x.TotalAmount);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Xuất PDF đơn hàng</title>

    <style>
            body {
                font-family: Arial, sans-serif;
                color: #111827;
                margin: 32px;
                font-size: 14px;
            }

            h1 {
                margin: 0 0 6px;
                font-size: 26px;
            }

            .meta {
                color: #6b7280;
                margin-bottom: 24px;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th {
                background: #f3f4f6;
                text-align: left;
                font-weight: 700;
            }

            th,
            td {
                border: 1px solid #d1d5db;
                padding: 10px;
                vertical-align: top;
            }

            .text-end {
                text-align: right;
            }

            .summary {
                margin-top: 20px;
                text-align: right;
                font-size: 18px;
                font-weight: 700;
            }

            .print-actions {
                margin-bottom: 20px;
            }

                .print-actions button {
                    border: 0;
                    border-radius: 8px;
                    background: #2563eb;
                    color: white;
                    padding: 10px 18px;
                    font-weight: 700;
                    cursor: pointer;
                }

            @@media print {
                .print-actions {
                    display: none;
                }

                body {
                    margin: 16px;
                }
            }
    </style>
</head>

<body>
    <div class="print-actions">
        <button onclick="window.print()">In / Lưu thành PDF</button>
    </div>

    <h1>Danh sách đơn hàng</h1>
    <div class="meta">
        Ngày xuất: @DateTime.Now.ToString("dd/MM/yyyy HH:mm") —
        Tổng số đơn: @Model.Count
    </div>

    <table>
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Khách hàng</th>
                <th>Giao hàng</th>
                <th>Ngày đặt</th>
                <th>Trạng thái</th>
                <th>Thanh toán</th>
                <th class="text-end">Tổng tiền</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        #@item.Id<br />
                        <small>@item.OrderCode</small>
                    </td>

                    <td>
                        @item.CustomerName<br />
                        <small>@item.CustomerEmail</small>
                    </td>

                    <td>@item.ShippingAddress</td>

                    <td>
                        @item.CreatedAt.ToString("dd/MM/yyyy")<br />
                        <small>@item.CreatedAt.ToString("HH:mm")</small>
                    </td>

                    <td>@GetOrderStatusText(item.OrderStatus)</td>

                    <td>@GetPaymentStatusText(item.PaymentStatus)</td>

                    <td class="text-end">
                        @item.TotalAmount.ToString("N0") đ
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="summary">
        Tổng cộng: @total.ToString("N0") đ
    </div>

    <script>
            window.addEventListener("load", function () {
                setTimeout(function () {
                    window.print();
                }, 500);
            });
    </script>
</body>
</html>

@functions {
    string GetOrderStatusText(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "Chờ xử lý",
            OrderStatus.Processing => "Đang xử lý",
            OrderStatus.Completed => "Hoàn thành",
            OrderStatus.Cancelled => "Đã hủy",
            _ => "Không xác định"
        };
    }

    string GetPaymentStatusText(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Pending => "Chờ thanh toán",
            PaymentStatus.Paid => "Đã thanh toán",
            PaymentStatus.Failed => "Thất bại",
            PaymentStatus.Cancelled => "Đã hủy",
            _ => "Không xác định"
        };
    }
}