@model MiniSmartstoreMvc.Models.ProductReview

@{
    ViewData["Title"] = "Chi tiết đánh giá";

    var productImage = string.IsNullOrWhiteSpace(Model.Product?.ImageUrl)
        ? "/images/products/no-image.jpg"
        : Model.Product.ImageUrl;

    var customerName = Model.User?.FullName;

    if (string.IsNullOrWhiteSpace(customerName))
    {
        customerName = Model.User?.Email ?? "Khách hàng";
    }
}

<div class="admin-review-page">
    <div class="admin-review-header">
        <div>
            <h1>Chi tiết đánh giá</h1>
            <p>Xem nội dung đánh giá và xử lý trạng thái hiển thị ngoài shop.</p>
        </div>

        <a asp-area="Admin"
           asp-controller="ProductReview"
           asp-action="Index"
           class="admin-review-back-btn">
            Quay lại
        </a>
    </div>

    <div class="admin-review-detail-card">
        <div class="admin-review-detail-product">
            <img src="@productImage"
                 onerror="this.src='/images/products/no-image.jpg'"
                 alt="@Model.Product?.Name" />

            <div>
                <span>Sản phẩm</span>
                <h2>@(Model.Product?.Name ?? "Sản phẩm đã bị xóa")</h2>

                @if (Model.Product != null)
                {
                    <a asp-area=""
                       asp-controller="Product"
                       asp-action="Details"
                       asp-route-id="@Model.ProductId"
                       target="_blank">
                        Xem sản phẩm ngoài shop
                    </a>
                }
            </div>
        </div>

        <div class="admin-review-detail-meta">
            <div>
                <span>Khách hàng</span>
                <strong>@customerName</strong>
                <small>@Model.User?.Email</small>
            </div>

            <div>
                <span>Ngày gửi</span>
                <strong>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
            </div>

            <div>
                <span>Trạng thái</span>

                @if (Model.IsApproved)
                {
                    <strong class="approved-text">Đang hiển thị</strong>
                }
                else
                {
                    <strong class="hidden-text">Đang ẩn</strong>
                }
            </div>
        </div>

        <div class="admin-review-detail-stars">
            @for (int i = 1; i <= 5; i++)
            {
                <span class="@(i <= Model.Rating ? "filled" : "")">★</span>
            }
        </div>

        <div class="admin-review-detail-content">
            <h3>@Model.Title</h3>
            <p>@Model.Comment</p>
        </div>

        <div class="admin-review-detail-actions">
            @if (Model.IsApproved)
            {
                <form asp-area="Admin"
                      asp-controller="ProductReview"
                      asp-action="Hide"
                      asp-route-id="@Model.Id"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="admin-review-action-btn warning">
                        Ẩn đánh giá
                    </button>
                </form>
            }
            else
            {
                <form asp-area="Admin"
                      asp-controller="ProductReview"
                      asp-action="Approve"
                      asp-route-id="@Model.Id"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="admin-review-action-btn success">
                        Duyệt đánh giá
                    </button>
                </form>
            }

            <form asp-area="Admin"
                  asp-controller="ProductReview"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post"
                  onsubmit="return confirm('Bạn có chắc muốn xóa đánh giá này không?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="admin-review-action-btn danger">
                    Xóa đánh giá
                </button>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-product-review.css" asp-append-version="true" />
}