@model MiniSmartstoreMvc.ViewModels.WhatsNewViewModel

@{
    ViewData["Title"] = "What’s new";
}

<div class="shop-service-page">
    <section class="shop-service-hero">
        <span>MiniSmartstore</span>
        <h1>What’s new</h1>
        <p>Cập nhật nhanh các sản phẩm mới, sản phẩm nổi bật và những mặt hàng đang giảm giá trong cửa hàng.</p>
    </section>

    <section class="shop-service-section">
        <div class="shop-service-section-head">
            <div>
                <h2>Sản phẩm mới nhất</h2>
                <p>Những sản phẩm vừa được thêm vào hệ thống.</p>
            </div>

            <a asp-controller="Product" asp-action="Index">Xem tất cả</a>
        </div>

        <div class="shop-service-product-grid">
            @foreach (var product in Model.NewProducts)
            {
                <partial name="_ServiceProductCard" model="product" />
            }
        </div>
    </section>

    <section class="shop-service-section">
        <div class="shop-service-section-head">
            <div>
                <h2>Sản phẩm nổi bật</h2>
                <p>Các sản phẩm được đánh dấu nổi bật trong trang quản trị.</p>
            </div>
        </div>

        @if (Model.FeaturedProducts.Any())
        {
            <div class="shop-service-product-grid">
                @foreach (var product in Model.FeaturedProducts)
                {
                    <partial name="_ServiceProductCard" model="product" />
                }
            </div>
        }
        else
        {
            <div class="shop-service-empty">Chưa có sản phẩm nổi bật.</div>
        }
    </section>

    <section class="shop-service-section">
        <div class="shop-service-section-head">
            <div>
                <h2>Đang giảm giá</h2>
                <p>Những sản phẩm có giá cũ lớn hơn giá bán hiện tại.</p>
            </div>
        </div>

        @if (Model.SaleProducts.Any())
        {
            <div class="shop-service-product-grid">
                @foreach (var product in Model.SaleProducts)
                {
                    <partial name="_ServiceProductCard" model="product" />
                }
            </div>
        }
        else
        {
            <div class="shop-service-empty">Chưa có sản phẩm đang giảm giá.</div>
        }
    </section>
</div>